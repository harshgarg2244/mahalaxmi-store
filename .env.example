# Supabase connection settings for this app.
# Copy this file to ".env" and fill in the values from your own Supabase project
# (Supabase dashboard -> Project Settings -> API). Do not commit real credentials.

# --- Browser-visible (safe to expose, protected by Row Level Security) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alias used by newer Supabase API keys (either name works in the app):
# VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (set in your hosting environment, never with VITE_) ---
# Used by server functions (authenticated requests and admin operations).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Alias used by newer Supabase API keys (either name works in the app):
# SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: Telegram order alerts (server-only) ---
# Create a bot with @BotFather, then set its token here and the chat ID in the
# owner Settings page inside the app.
TELEGRAM_BOT_TOKEN=
